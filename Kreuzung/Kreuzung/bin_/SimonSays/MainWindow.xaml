<Window x:Class="SimonSays.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simon Says" Height="500" Width="400"
        Background="#2C3E50" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="txtStatus" Text="Press Start to play!"
                   Foreground="White" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <UniformGrid Rows="2" Columns="2" Margin="0,0,0,20">
            <Button x:Name="btn0" Content="Red" Tag="0"
                    Height="120" Margin="5" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#E74C3C" Opacity="0.5"
                    Click="Color_Click" IsEnabled="False"
                    BorderThickness="0"/>
            <Button x:Name="btn1" Content="Blue" Tag="1"
                    Height="120" Margin="5" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#3498DB" Opacity="0.5"
                    Click="Color_Click" IsEnabled="False"
                    BorderThickness="0"/>
            <Button x:Name="btn2" Content="Green" Tag="2"
                    Height="120" Margin="5" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#2ECC71" Opacity="0.5"
                    Click="Color_Click" IsEnabled="False"
                    BorderThickness="0"/>
            <Button x:Name="btn3" Content="Yellow" Tag="3"
                    Height="120" Margin="5" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#F1C40F" Opacity="0.5"
                    Click="Color_Click" IsEnabled="False"
                    BorderThickness="0"/>
        </UniformGrid>

        <Button Content="Start / New Game" FontSize="16" FontWeight="Bold"
                Padding="20,10" HorizontalAlignment="Center"
                Background="#1ABC9C" Foreground="White" BorderThickness="0"
                Click="Start_Click"/>
    </StackPanel>
</Window>
