<Window x:Class="Gomoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gomoku — 5 in a Row" Height="700" Width="700"
        MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar: status + controls -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="cmbMode" Width="160" VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectedIndex="0" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="Human vs AI"/>
                        <ComboBoxItem Content="Human vs Human"/>
                        <ComboBoxItem Content="AI vs AI"/>
                    </ComboBox>
                    <Button Content="New Game" Click="NewGame_Click" Padding="12,6"
                            Background="#4A90D9" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="txtStatus" Text="Player 1's turn (X)"
                           Foreground="White" FontSize="16" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Game board -->
        <ItemsControl x:Name="boardControl" Margin="4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid x:Name="boardGrid" Rows="9" Columns="9"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="Cell_Click" Tag="{Binding}"
                            Margin="1" FontSize="18" FontWeight="Bold"
                            Content="{Binding Symbol}"
                            ToolTip="{Binding Symbol}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Player}" Value="1">
                                        <Setter Property="Background" Value="#4A90D9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Player}" Value="2">
                                        <Setter Property="Background" Value="#D94A4A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
