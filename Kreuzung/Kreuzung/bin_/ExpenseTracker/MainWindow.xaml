<Window x:Class="ExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expense Tracker" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" >
            <Button x:Name="BtnAdd" Content="+ Add Transaction" Padding="12,6" FontWeight="Bold"
                    Background="#27AE60" Foreground="White" Click="BtnAdd_Click" Margin="0,0,15,0"/>

            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbCategoryFilter" Width="130" Margin="0,0,15,0"
                      SelectedIndex="0"/>

            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="DpFrom" Width="130" Margin="0,0,10,0"/>

            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="DpTo" Width="130" Margin="0,0,15,0"/>

            <Button x:Name="BtnFilter" Content="Filter" Padding="12,6" Click="BtnFilter_Click"
                    Margin="0,0,5,0"/>
            <Button x:Name="BtnReset" Content="Reset" Padding="12,6" Click="BtnReset_Click"/>
        </StackPanel>

        <!-- Summary Panel -->
        <Border DockPanel.Dock="Top" Background="#ECF0F1" Margin="10,0,10,10" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Balance" FontSize="14" HorizontalAlignment="Center" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtBalance" Text="0.00 EUR" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Total Income" FontSize="14" HorizontalAlignment="Center" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtIncome" Text="0.00 EUR" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Total Expenses" FontSize="14" HorizontalAlignment="Center" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtExpenses" Text="0.00 EUR" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#E74C3C"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- StatusBar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="0 transactions"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Transaction ListView -->
        <ListView x:Name="LvTransactions" Margin="10,0,10,5"
                  GridViewColumnHeader.Click="LvTransactions_ColumnHeaderClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" Width="110"
                                    DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                    <GridViewColumn Header="Description" Width="250"
                                    DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Category" Width="120"
                                    DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Type" Width="80"
                                    DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="Amount" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsIncome}" Value="False">
                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
