<Window x:Class="ExpenseTracker.AddTransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Transaction" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0" Text="Description:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDescription" Margin="0,0,0,10" Padding="4"/>

        <!-- Amount -->
        <TextBlock Grid.Row="1" Text="Amount:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAmount" Margin="0,0,0,10" Padding="4"/>

        <!-- Category -->
        <TextBlock Grid.Row="2" Text="Category:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbCategory" Margin="0,0,0,10"/>

        <!-- Type (Income/Expense) -->
        <TextBlock Grid.Row="3" Text="Type:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="RbExpense" Content="Expense" IsChecked="True" Margin="0,0,20,0"
                         VerticalAlignment="Center"/>
            <RadioButton x:Name="RbIncome" Content="Income" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Date -->
        <TextBlock Grid.Row="4" Text="Date:" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpDate" Margin="0,0,0,10"/>

        <!-- Validation message -->
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="TxtError" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Padding="4,6" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" Padding="4,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
