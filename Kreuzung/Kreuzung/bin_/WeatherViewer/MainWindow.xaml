<Window x:Class="WeatherViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Data Viewer - Vienna" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- TOOLBAR: Filters and Load Button -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="8" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpFrom" Width="130" Margin="0,0,15,0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpTo" Width="130" Margin="0,0,15,0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Condition:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbCondition" Width="120" Margin="0,0,15,0"
                          SelectionChanged="Filter_Changed"/>

                <Button x:Name="btnLoadFile" Content="Load CSV File..." Padding="10,4"
                        Click="BtnLoadFile_Click"/>
            </WrapPanel>
        </Border>

        <!-- STATISTICS PANEL -->
        <Border DockPanel.Dock="Top" Background="#E8F4FD" Padding="10" BorderBrush="#B0D4E8" BorderThickness="0,0,0,1">
            <UniformGrid Rows="1" Columns="5">
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Avg Temp" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtAvgTemp" Text="--" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#D35400"/>
                    <TextBlock Text="°C" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Min Temp" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtMinTemp" Text="--" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#2980B9"/>
                    <TextBlock Text="°C" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Max Temp" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtMaxTemp" Text="--" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#C0392B"/>
                    <TextBlock Text="°C" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Avg Humidity" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtAvgHumidity" Text="--" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#27AE60"/>
                    <TextBlock Text="%" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Avg Wind" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtAvgWind" Text="--" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#8E44AD"/>
                    <TextBlock Text="km/h" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtRecordCount" Text="Records: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtDateRange" Text="Date range: --"/>
            </StatusBarItem>
        </StatusBar>

        <!-- DATA GRID -->
        <DataGrid x:Name="dgWeather"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  HeadersVisibility="Column"
                  Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                    Width="110"/>
                <DataGridTextColumn Header="Temp (°C)" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Temperature" StringFormat="{}{0:F1}"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding TempColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Humidity (%)" Binding="{Binding Humidity}"
                                    Width="100"/>
                <DataGridTextColumn Header="Wind (km/h)" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="WindSpeed" StringFormat="{}{0:F1}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
