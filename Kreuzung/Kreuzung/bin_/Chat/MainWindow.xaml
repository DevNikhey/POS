<Window x:Class="Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat — Server + Client" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <TabControl>
        <!-- SERVER TAB -->
        <TabItem Header="Server">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Port:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPort" Width="60" Text="5000" VerticalAlignment="Center"/>
                        <Button x:Name="btnStartServer" Content="Start Server" Click="StartServer_Click"
                                Margin="12,0,0,0" Padding="16,4" Background="#4A90D9" Foreground="White" BorderThickness="0"/>
                        <Button x:Name="btnStopServer" Content="Stop Server" Click="StopServer_Click"
                                Margin="8,0,0,0" Padding="16,4" Background="#D94A4A" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="lstServerLog" Margin="8" FontFamily="Consolas"/>
            </DockPanel>
        </TabItem>

        <!-- CLIENT TAB -->
        <TabItem Header="Client">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Host:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtHost" Width="100" Text="127.0.0.1" VerticalAlignment="Center"/>
                        <TextBlock Text="Port:" Foreground="White" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="txtClientPort" Width="60" Text="5000" VerticalAlignment="Center"/>
                        <Button x:Name="btnConnect" Content="Connect" Click="Connect_Click"
                                Margin="12,0,0,0" Padding="12,4" Background="#4A90D9" Foreground="White" BorderThickness="0"/>

                        <TextBlock Text="User:" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="txtUser" Width="80" VerticalAlignment="Center"/>
                        <TextBlock Text="Pass:" Foreground="White" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <PasswordBox x:Name="txtPass" Width="80" VerticalAlignment="Center"/>
                        <Button Content="Register" Click="Register_Click" Margin="8,0,0,0" Padding="8,4"/>
                        <Button Content="Login" Click="Login_Click" Margin="4,0,0,0" Padding="8,4"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="#3D3D40" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Room:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtRoom" Width="100" Text="general" VerticalAlignment="Center"/>
                        <Button Content="Join" Click="Join_Click" Margin="8,0,0,0" Padding="12,4"/>
                        <TextBlock x:Name="txtClientStatus" Text="Disconnected" Foreground="#FF8888"
                                   VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Send" Click="Send_Click" Padding="16,4" Margin="8,0,0,0"/>
                        <TextBox x:Name="txtMessage" KeyDown="Message_KeyDown"/>
                    </DockPanel>
                </Border>

                <ListBox x:Name="lstMessages" Margin="8" FontFamily="Consolas"/>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
