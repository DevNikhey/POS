<Window x:Class="Einkaufsliste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einkaufsliste — Shopping List" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Save as XML" Click="Save_Click"/>
                <MenuItem Header="_Load from XML" Click="Load_Click"/>
                <Separator/>
                <MenuItem Header="_Clear List" Click="Clear_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top: Add items -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Group:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbGroup" Width="120" SelectionChanged="Group_Changed"/>
                <TextBlock Text="Product:" Foreground="White" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="cmbProduct" Width="140" DisplayMemberPath="Name"/>
                <TextBlock Text="Amount:" Foreground="White" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="txtAmount" Width="50" Text="1" VerticalAlignment="Center"/>
                <Button Content="Add" Click="Add_Click" Margin="12,0,0,0" Padding="16,4"
                        Background="#4A90D9" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Search:" Foreground="White" VerticalAlignment="Center" Margin="24,0,6,0"/>
                <TextBox x:Name="txtSearch" Width="120" VerticalAlignment="Center" TextChanged="Search_Changed"/>
                <ComboBox x:Name="cmbSearch" Width="140" Margin="6,0,0,0" DisplayMemberPath="Name"
                          SelectionChanged="SearchResult_Selected"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Shopping list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Shopping List" FontWeight="Bold" FontSize="14" Margin="8,8,8,4"/>
                <ListBox x:Name="lstItems" Margin="8,0,8,8" MouseDoubleClick="Item_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Amount}" FontWeight="Bold" Width="30"/>
                                <TextBlock Text="x " Opacity="0.5"/>
                                <TextBlock Text="{Binding Name}" Width="120"/>
                                <TextBlock Text="{Binding Unit}" Opacity="0.5" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Grouped TreeView -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Grouped View" FontWeight="Bold" FontSize="14" Margin="8,8,8,4"/>
                <TreeView x:Name="treeGrouped" Margin="8,0,8,8">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"/>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
