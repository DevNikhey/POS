<Window x:Class="Chess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess" Height="700" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Status Bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,5">
            <TextBlock x:Name="StatusText" Text="White's Turn"
                       FontSize="22" FontWeight="Bold" Foreground="White"
                       Margin="0,0,20,0" VerticalAlignment="Center"/>
            <Button Content="New Game" Click="NewGame_Click"
                    FontSize="16" Padding="15,5"
                    Background="#4A90D9" Foreground="White"
                    BorderBrush="#3A7BC8" Cursor="Hand"/>
        </StackPanel>

        <!-- Chess Board -->
        <Border BorderBrush="#1A1A1A" BorderThickness="3"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="10">
            <ItemsControl x:Name="BoardGrid" ItemsSource="{Binding Squares}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8" Width="560" Height="560"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Square_Click"
                                Tag="{Binding}"
                                FontSize="38"
                                Content="{Binding Symbol}"
                                Cursor="Hand"
                                BorderThickness="3">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{Binding BgColor}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Highlighted}" Value="True">
                                            <Setter Property="BorderBrush" Value="#44CC44"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</Window>
