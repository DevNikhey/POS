<Window x:Class="EmployeeDirectory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Directory" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Padding="4">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="4,0"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <Separator/>
            <TextBlock Text="Department:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="DepartmentFilter" Width="150" Margin="4,0"
                      SelectionChanged="DepartmentFilter_SelectionChanged"/>
            <Separator/>
            <Button Content="Load CSV" Padding="8,2" Margin="4,0"
                    Click="LoadCsv_Click"/>
            <Button Content="Export XML" Padding="8,2" Margin="4,0"
                    Click="ExportXml_Click"/>
        </ToolBar>

        <!-- StatusBar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Statistics Panel -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10,6">
            <WrapPanel>
                <TextBlock Text="Total Employees: " FontWeight="Bold"/>
                <TextBlock x:Name="TotalEmployeesText" Margin="0,0,20,0"/>
                <TextBlock Text="Avg Salary: " FontWeight="Bold"/>
                <TextBlock x:Name="AvgSalaryText" Margin="0,0,20,0"/>
                <TextBlock Text="Largest Department: " FontWeight="Bold"/>
                <TextBlock x:Name="LargestDeptText" Margin="0,0,20,0"/>
                <TextBlock Text="Longest Tenure: " FontWeight="Bold"/>
                <TextBlock x:Name="LongestTenureText"/>
            </WrapPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: TreeView grouped by Department -->
            <TreeView x:Name="EmployeeTree" Grid.Column="0" Margin="4"
                      SelectedItemChanged="EmployeeTree_SelectedItemChanged">
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- Right: Detail panel -->
            <Border Grid.Column="2" Margin="8" Padding="16"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <TextBlock x:Name="DetailName" FontSize="22" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailPosition" FontSize="14"
                                   Foreground="#666666" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailId"
                                       Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailEmail"
                                       Foreground="Blue" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Department:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailDepartment"
                                       Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Position:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailPositionFull"
                                       Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Salary:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailSalary"
                                       FontWeight="Bold" Foreground="Green" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hire Date:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailHireDate"
                                       Margin="0,4"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Tenure:"
                                       FontWeight="SemiBold" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetailTenure"
                                       Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
