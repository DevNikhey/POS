<Window x:Class="StudentGrades.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notenbuch - Student Gradebook" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Toolbar -->
        <ToolBar DockPanel.Dock="Top" Height="40">
            <Button x:Name="BtnAddStudent" Content="+ Schueler" Click="BtnAddStudent_Click"
                    Padding="8,2" Margin="2"/>
            <Button x:Name="BtnDeleteStudent" Content="- Schueler" Click="BtnDeleteStudent_Click"
                    Padding="8,2" Margin="2"/>
            <Separator/>
            <Button x:Name="BtnAddGrade" Content="+ Note" Click="BtnAddGrade_Click"
                    Padding="8,2" Margin="2"/>
            <Button x:Name="BtnDeleteGrade" Content="- Note" Click="BtnDeleteGrade_Click"
                    Padding="8,2" Margin="2"/>
            <Separator/>
            <TextBlock Text="Klasse:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="CmbClassFilter" Width="80" SelectionChanged="CmbClassFilter_SelectionChanged"
                      VerticalAlignment="Center"/>
        </ToolBar>

        <!-- Bottom StatusBar -->
        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="TxtStudentCount" Text="Schueler: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtClassAverage" Text="Klassenschnitt: -"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Students DataGrid -->
            <DataGrid x:Name="DgStudents" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="DgStudents_SelectionChanged"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="60"/>
                    <DataGridTextColumn Header="Schnitt" Binding="{Binding Average, StringFormat=N2}" Width="65"/>
                    <DataGridTextColumn Header="Noten" Binding="{Binding GradeCount}" Width="55"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Right: Grades DataGrid -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="TxtSelectedStudent"
                           Text="Noten" FontWeight="SemiBold" FontSize="14"
                           Margin="6,6,6,4"/>
                <DataGrid x:Name="DgGrades"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F5F5F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fach" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Score}" Width="50"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
