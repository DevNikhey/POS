<Window x:Class="StudentGrades.AddGradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note hinzufuegen" Height="240" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="TxtStudentName" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fach:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbSubject" Margin="0,0,0,8">
            <ComboBoxItem Content="Mathematik"/>
            <ComboBoxItem Content="Deutsch"/>
            <ComboBoxItem Content="Englisch"/>
            <ComboBoxItem Content="Physik"/>
            <ComboBoxItem Content="Informatik"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Note:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbScore" Margin="0,0,0,8">
            <ComboBoxItem Content="1 - Sehr gut"/>
            <ComboBoxItem Content="2 - Gut"/>
            <ComboBoxItem Content="3 - Befriedigend"/>
            <ComboBoxItem Content="4 - Genuegend"/>
            <ComboBoxItem Content="5 - Nicht genuegend"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum:" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="DpDate" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,8,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Abbrechen" Width="75" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
