<Window x:Class="Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship" Height="600" Width="900"
        Background="#1A237E" ResizeMode="CanResize">
    <DockPanel Margin="10">
        <!-- Status bar at top -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock x:Name="StatusLabel" Text="Your turn! Click on the enemy board to fire."
                       Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="NewGameButton" Content="New Game" Click="NewGame_Click"
                    Padding="15,5" FontSize="14" Background="#4CAF50" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Two boards side by side -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Player Board (left) -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Your Fleet" Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <ItemsControl x:Name="PlayerBoardControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="10" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#0D47A1" BorderThickness="1" Margin="1">
                                <TextBlock Text="{Binding Display}" Background="{Binding Color}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           Foreground="White" Padding="2"
                                           MinWidth="28" MinHeight="28"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Enemy Board (right) -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Enemy Waters" Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <ItemsControl x:Name="EnemyBoardControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="10" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#0D47A1" BorderThickness="1" Margin="1"
                                    Cursor="Crosshair" MouseLeftButtonDown="EnemyCell_Click">
                                <TextBlock Text="{Binding Display}" Background="{Binding Color}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                           Foreground="White" Padding="2"
                                           MinWidth="28" MinHeight="28"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
