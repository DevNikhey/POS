<Window x:Class="ContactBook.ContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact" Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name *" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TxtFirstName" Grid.Row="0" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Name *" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TxtLastName" Grid.Row="1" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TxtEmail" Grid.Row="2" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Phone" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TxtPhone" Grid.Row="3" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Category" VerticalAlignment="Center" Margin="0,4" />
        <ComboBox x:Name="CmbCategory" Grid.Row="4" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Address" VerticalAlignment="Center" Margin="0,4" />
        <TextBox x:Name="TxtAddress" Grid.Row="5" Grid.Column="1" Margin="0,4" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Notes" VerticalAlignment="Top" Margin="0,4" />
        <TextBox x:Name="TxtNotes" Grid.Row="6" Grid.Column="1" Margin="0,4"
                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="80" Margin="0,0,8,0"
                    Click="BtnSave_Click" IsDefault="True" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
