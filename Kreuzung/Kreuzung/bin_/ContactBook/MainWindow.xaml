<Window x:Class="ContactBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contact Book" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Height="40">
            <Button x:Name="BtnAdd" Content="Add" Click="BtnAdd_Click" Padding="8,2" />
            <Button x:Name="BtnEdit" Content="Edit" Click="BtnEdit_Click" Padding="8,2" />
            <Button x:Name="BtnDelete" Content="Delete" Click="BtnDelete_Click" Padding="8,2" />
            <Separator />
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="4,0" />
            <TextBox x:Name="TxtSearch" Width="180" VerticalAlignment="Center"
                     TextChanged="TxtSearch_TextChanged" />
            <Separator />
            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox x:Name="CmbCategory" Width="120" VerticalAlignment="Center"
                      SelectionChanged="CmbCategory_SelectionChanged" />
        </ToolBar>

        <!-- StatusBar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Contacts: 0" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Contact list -->
            <ListView x:Name="LstContacts" Grid.Column="0" Margin="4"
                      SelectionChanged="LstContacts_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="170"
                                        DisplayMemberBinding="{Binding FullName}" />
                        <GridViewColumn Header="Category" Width="80"
                                        DisplayMemberBinding="{Binding Category}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="LightGray" />

            <!-- Right: Detail panel -->
            <ScrollViewer Grid.Column="2" Margin="8" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlDetails">
                    <TextBlock Text="Contact Details" FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <TextBlock Text="First Name" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailFirstName" Margin="0,0,0,4" />

                    <TextBlock Text="Last Name" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailLastName" Margin="0,0,0,4" />

                    <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailEmail" Margin="0,0,0,4" />

                    <TextBlock Text="Phone" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailPhone" Margin="0,0,0,4" />

                    <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailCategory" Margin="0,0,0,4" />

                    <TextBlock Text="Address" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailAddress" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtDetailNotes" TextWrapping="Wrap" Margin="0,0,0,4" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
