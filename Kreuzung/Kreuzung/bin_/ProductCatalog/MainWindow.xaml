<Window x:Class="ProductCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Produktkatalog - WPF Demo"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="900"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- StatusBar unten -->
        <StatusBar DockPanel.Dock="Bottom" Background="#37474F" Foreground="White" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="StatusProducts" Text="Produkte: 0" Foreground="White"/>
            </StatusBarItem>
            <Separator Background="#546E7A"/>
            <StatusBarItem>
                <TextBlock x:Name="StatusCartItems" Text="Warenkorb: 0 Artikel" Foreground="White"/>
            </StatusBarItem>
            <Separator Background="#546E7A"/>
            <StatusBarItem>
                <TextBlock x:Name="StatusCartTotal" Text="Gesamt: €0.00" Foreground="#4CAF50" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Hauptbereich: 3 Spalten -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.2*" MinWidth="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.3*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LINKE SPALTE: Produktliste ========== -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Produktliste" Style="{StaticResource HeaderStyle}" Foreground="#37474F"/>

                <!-- Filter und Sortierung -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- Suchfeld -->
                        <TextBox x:Name="SearchBox"
                                 Padding="8,6" Margin="0,0,0,8"
                                 Tag="Produkt suchen..."
                                 TextChanged="SearchBox_TextChanged"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kategorie-Filter -->
                            <ComboBox x:Name="CategoryFilter" Grid.Column="0"
                                      Padding="6,4"
                                      SelectionChanged="CategoryFilter_SelectionChanged"/>

                            <!-- Sortierung -->
                            <ComboBox x:Name="SortCombo" Grid.Column="2"
                                      Padding="6,4"
                                      SelectionChanged="SortCombo_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Produktliste -->
                <ListView x:Name="ProductList"
                          Margin="0,8,0,0"
                          SelectionChanged="ProductList_SelectionChanged"
                          BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="160"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Kategorie" Width="90"
                                            DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Preis" Width="80"
                                            DisplayMemberBinding="{Binding PriceText}"/>
                            <GridViewColumn Header="Lager" Width="55"
                                            DisplayMemberBinding="{Binding Stock}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- ========== MITTLERE SPALTE: Produktdetails ========== -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Produktdetails" Style="{StaticResource HeaderStyle}" Foreground="#37474F"/>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <!-- Produktname -->
                        <TextBlock x:Name="DetailName"
                                   FontSize="18" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="#1565C0"/>

                        <!-- Kategorie -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Kategorie: " FontWeight="SemiBold" Foreground="#757575"/>
                            <TextBlock x:Name="DetailCategory" Foreground="#424242"/>
                        </StackPanel>

                        <!-- Preis -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Preis: " FontWeight="SemiBold" Foreground="#757575"/>
                            <TextBlock x:Name="DetailPrice" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>

                        <!-- Lagerbestand -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Lagerbestand: " FontWeight="SemiBold" Foreground="#757575"/>
                            <TextBlock x:Name="DetailStock" Foreground="#424242"/>
                        </StackPanel>

                        <!-- Verfuegbarkeit -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#757575"/>
                            <TextBlock x:Name="DetailAvailability"/>
                        </StackPanel>

                        <!-- Beschreibung -->
                        <TextBlock Text="Beschreibung:" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailDescription"
                                   TextWrapping="Wrap" Foreground="#616161"
                                   Margin="0,0,0,16"/>

                        <!-- Separator -->
                        <Separator Margin="0,0,0,12"/>

                        <!-- Menge und Zum Warenkorb -->
                        <TextBlock Text="Zum Warenkorb hinzufuegen:" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Menge-Spinner -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <Button x:Name="BtnQuantityDown" Content=" - "
                                        Width="30" Height="30" FontSize="16" FontWeight="Bold"
                                        Click="BtnQuantityDown_Click"/>
                                <TextBlock x:Name="QuantityText" Text="1"
                                           Width="40" TextAlignment="Center"
                                           VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <Button x:Name="BtnQuantityUp" Content=" + "
                                        Width="30" Height="30" FontSize="16" FontWeight="Bold"
                                        Click="BtnQuantityUp_Click"/>
                            </StackPanel>

                            <!-- Button -->
                            <Button x:Name="BtnAddToCart" Grid.Column="2"
                                    Content="In den Warenkorb"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddToCart_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Platzhalter wenn nichts ausgewaehlt -->
                <TextBlock x:Name="DetailPlaceholder"
                           Text="Waehlen Sie ein Produkt aus der Liste aus."
                           Foreground="#9E9E9E" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,40,0,0"
                           Visibility="Visible"/>
            </DockPanel>

            <!-- ========== RECHTE SPALTE: Warenkorb ========== -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Warenkorb" Style="{StaticResource HeaderStyle}" Foreground="#37474F"/>

                <!-- Warenkorb-Summe und Leeren-Button unten -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gesamtsumme:" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CartTotalText" Grid.Column="1"
                                       Text="€0.00" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                        </Grid>
                        <Button x:Name="BtnClearCart" Content="Warenkorb leeren"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch"
                                Click="BtnClearCart_Click"/>
                    </StackPanel>
                </Border>

                <!-- Warenkorb-Liste -->
                <ListView x:Name="CartList"
                          BorderBrush="#E0E0E0" BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Produktname -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Product.Name}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                <!-- Entfernen-Button -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Content="X" FontSize="10"
                                        Width="22" Height="22"
                                        Background="#EF5350" Foreground="White" BorderThickness="0"
                                        Tag="{Binding Product.Id}"
                                        Click="BtnRemoveFromCart_Click"
                                        Cursor="Hand" ToolTip="Entfernen"/>

                                <!-- Menge und Preis -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Foreground="#757575">
                                        <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                        <Run Text="x"/>
                                        <Run Text="{Binding Product.PriceText, Mode=OneWay}"/>
                                        <Run Text=" = "/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TotalText}" FontWeight="Bold" Foreground="#2E7D32"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
