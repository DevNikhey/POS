<Window x:Class="Wordle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wordle" Height="550" Width="400"
        Background="#121213"
        KeyDown="Window_KeyDown"
        Focusable="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top"
                   Text="WORDLE"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,5"/>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusText}"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Button DockPanel.Dock="Bottom"
                Content="New Game"
                Click="NewGame_Click"
                FontSize="14"
                Padding="15,5"
                HorizontalAlignment="Center"
                Margin="0,10,0,5"/>

        <ItemsControl ItemsSource="{Binding Grid}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="6" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="52" Height="52" Margin="3"
                            Background="{Binding Color}"
                            BorderBrush="#565758"
                            BorderThickness="2"
                            CornerRadius="2">
                        <TextBlock Text="{Binding Display}"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
