<Window x:Class="Hangman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hangman" Height="600" Width="500"
        Background="#2C3E50"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Center">
            <!-- ASCII Art -->
            <TextBlock x:Name="AsciiArtText"
                       Text="{Binding AsciiArt}"
                       FontFamily="Consolas"
                       FontSize="22"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20" />

            <!-- Display Word -->
            <TextBlock x:Name="DisplayWordText"
                       Text="{Binding DisplayWord}"
                       FontFamily="Consolas"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15" />

            <!-- Status Text -->
            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       FontSize="18"
                       Foreground="#ECF0F1"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Letter Buttons -->
            <WrapPanel x:Name="LetterPanel"
                       HorizontalAlignment="Center"
                       MaxWidth="420"
                       Margin="0,0,0,20" />

            <!-- New Game Button -->
            <Button Content="Neues Spiel"
                    Click="NewGame_Click"
                    FontSize="18"
                    FontWeight="Bold"
                    Padding="20,8"
                    HorizontalAlignment="Center"
                    Background="#27AE60"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
