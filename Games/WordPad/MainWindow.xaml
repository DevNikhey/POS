<Window x:Class="WordPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordPad — Rich Text Editor" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="ApplicationCommands.New"/>
                <Separator/>
                <MenuItem Header="_Open..." Click="Open_Click"/>
                <MenuItem Header="_Save As..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=rtb}"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=rtb}"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=rtb}"/>
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=rtb}"/>
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=rtb}"/>
                <Separator/>
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=rtb}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top" Padding="4">
            <!-- Clipboard -->
            <Button Content="Cut" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=rtb}" ToolTip="Cut (Ctrl+X)"/>
            <Button Content="Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=rtb}" ToolTip="Copy (Ctrl+C)"/>
            <Button Content="Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=rtb}" ToolTip="Paste (Ctrl+V)"/>
            <Separator/>

            <!-- Undo/Redo -->
            <Button Content="Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=rtb}" ToolTip="Undo (Ctrl+Z)"/>
            <Button Content="Redo" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=rtb}" ToolTip="Redo (Ctrl+Y)"/>
            <Separator/>

            <!-- Font formatting -->
            <ToggleButton x:Name="btnBold" Content="B" FontWeight="Bold" Width="28"
                          Click="Bold_Click" ToolTip="Bold (Ctrl+B)"/>
            <ToggleButton x:Name="btnItalic" Content="I" FontStyle="Italic" Width="28"
                          Click="Italic_Click" ToolTip="Italic (Ctrl+I)"/>
            <ToggleButton x:Name="btnUnderline" Width="28"
                          Click="Underline_Click" ToolTip="Underline (Ctrl+U)">
                <TextBlock TextDecorations="Underline" Text="U"/>
            </ToggleButton>
            <Separator/>

            <!-- Font size -->
            <TextBlock Text="Size:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="cmbFontSize" Width="55" IsEditable="True" SelectionChanged="FontSize_Changed">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12" IsSelected="True"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="36"/>
                <ComboBoxItem Content="48"/>
                <ComboBoxItem Content="72"/>
            </ComboBox>
            <Separator/>

            <!-- Alignment -->
            <Button Content="Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=rtb}"/>
            <Button Content="Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=rtb}"/>
            <Button Content="Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=rtb}"/>
            <Separator/>

            <!-- Lists -->
            <Button Content="Bullets" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=rtb}"/>
            <Button Content="Numbers" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=rtb}"/>
        </ToolBar>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- RichTextBox -->
        <RichTextBox x:Name="rtb" AcceptsTab="True" Padding="8" FontSize="12"
                     SelectionChanged="Rtb_SelectionChanged" VerticalScrollBarVisibility="Auto">
            <FlowDocument>
                <Paragraph>
                    <Run Text="Welcome to WordPad! Try formatting this text using the toolbar above."/>
                </Paragraph>
                <Paragraph>
                    <Run Text="You can use "/>
                    <Bold>Ctrl+B for bold</Bold>
                    <Run Text=", "/>
                    <Italic>Ctrl+I for italic</Italic>
                    <Run Text=", and "/>
                    <Underline>Ctrl+U for underline</Underline>
                    <Run Text="."/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </DockPanel>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed"/>
    </Window.CommandBindings>
</Window>
