<Window x:Class="LoginRegister.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoginRegister"
        Title="Login &amp; Register" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" Background="#ECECEC">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="2" Opacity="0.2"/>
    </Window.Resources>

    <Grid>
        <local:LoginControl x:Name="loginControl"/>
        <local:RegisterControl x:Name="registerControl" Visibility="Collapsed"/>

        <!-- Welcome overlay (shown after successful login/register) -->
        <Border x:Name="welcomeOverlay" Visibility="Collapsed" Background="White"
                CornerRadius="8" Padding="40" MaxWidth="400" MaxHeight="200"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="txtWelcome" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Content="Logout" Click="Logout_Click" Padding="16,8"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
