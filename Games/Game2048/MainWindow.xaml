<Window x:Class="Game2048.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2048" Width="420" Height="520"
        Background="#FAF8EF"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <DockPanel Margin="16">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#776E65"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            <Button Content="New Game" Click="NewGame_Click"
                    FontSize="16" FontWeight="Bold"
                    Padding="16,8"
                    Background="#8F7A66" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Game Board -->
        <Border Background="#BBADA0" CornerRadius="8" Padding="8"
                DockPanel.Dock="Top">
            <ItemsControl ItemsSource="{Binding Grid}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Margin="4"
                                Height="80" Width="80">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding BgColor}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Display}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding FgColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

    </DockPanel>
</Window>
