<Window x:Class="PenteClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pente" Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Connection Screen -->
        <Grid x:Name="ConnectionPanel" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Pente" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Spielername:" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,10" Padding="4"/>

                <TextBlock Text="Server-Adresse:" Margin="0,0,0,4"/>
                <TextBox x:Name="ServerBox" Text="127.0.0.1" Margin="0,0,0,10" Padding="4"/>

                <TextBlock Text="Port:" Margin="0,0,0,4"/>
                <TextBox x:Name="PortBox" Text="5050" Margin="0,0,0,10" Padding="4"/>

                <Button x:Name="ConnectButton" Content="Verbinden" Padding="8,4"
                        Click="ConnectButton_Click" Margin="0,10,0,10"/>

                <TextBlock x:Name="StatusLabel" Text="" HorizontalAlignment="Center"
                           Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Game Screen -->
        <Grid x:Name="GamePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Board Area -->
            <Border Grid.Column="0" Margin="10" Background="#E8D4A0" BorderBrush="Black" BorderThickness="1">
                <Canvas x:Name="BoardCanvas" Width="570" Height="570"
                        MouseLeftButtonDown="BoardCanvas_MouseDown"
                        Background="Transparent"/>
            </Border>

            <!-- Info + Chat Panel -->
            <Grid Grid.Column="1" Margin="5,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Info Panel -->
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource HeaderLabel}" Text="Spielinfo"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Deine Farbe: " Style="{StaticResource InfoLabel}"/>
                        <Ellipse x:Name="MyColorIndicator" Width="18" Height="18"
                                 Stroke="Black" StrokeThickness="1" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TurnLabel" Style="{StaticResource InfoLabel}"
                               Text="Warte auf Spielstart..." FontWeight="SemiBold"/>

                    <TextBlock x:Name="Player1Label" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="Player2Label" Style="{StaticResource InfoLabel}"/>

                    <Separator Margin="0,8"/>

                    <TextBlock x:Name="WhiteCaptureLabel" Style="{StaticResource InfoLabel}"
                               Text="Weiss: 0 Gefangene"/>
                    <TextBlock x:Name="BlackCaptureLabel" Style="{StaticResource InfoLabel}"
                               Text="Schwarz: 0 Gefangene"/>

                    <TextBlock x:Name="MoveCountLabel" Style="{StaticResource InfoLabel}"
                               Text="Zug: 0"/>

                    <Separator Margin="0,8"/>

                    <Button x:Name="ScoreboardButton" Content="Rangliste"
                            Padding="8,4" Click="ScoreboardButton_Click" Margin="0,4"/>
                </StackPanel>

                <!-- Chat Panel -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HeaderLabel}" Text="Chat"/>
                    <ListBox x:Name="ChatList" Grid.Row="1" Margin="0,4"/>
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Grid.Column="0" Padding="4"
                                 KeyDown="ChatInput_KeyDown"/>
                        <Button x:Name="ChatSendButton" Grid.Column="1" Content="Senden"
                                Padding="8,4" Margin="4,0,0,0" Click="ChatSendButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
