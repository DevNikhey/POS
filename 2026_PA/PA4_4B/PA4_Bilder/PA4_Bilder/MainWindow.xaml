<Window x:Class="PA4_4B.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PA4_4B"
        mc:Ignorable="d"
        Title="4. praktische Arbeit" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Key="PersonTemplate" DataType="{x:Type local:Bild}">
            <Border BorderThickness="5">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>Name:</TextBlock>
                        <TextBlock Width="100" Grid.Column="0" Text="{Binding Path=name}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>Longitude:</TextBlock>
                        <TextBlock Width="100" Grid.Column="1" Text="{Binding Path=longitude}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>Latitude:</TextBlock>
                        <TextBlock Width="100" Grid.Column="1" Text="{Binding Path=latitude}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="492"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Grid.Column="1"
            BorderBrush="Black"
            BorderThickness="1">
            <Grid>
                <Image x:Name="Map" Source="/World.jpg" Stretch="Fill"/>

                <Canvas x:Name="MapCanvas"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
            BorderBrush="Black"
            BorderThickness="1">

            <!-- A1: Grid statt StackPanel, ListBox ohne fixe Hoehe (fuellt den Platz) -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Click="Button_Click">Neue Bilder</Button>
                <ListBox Grid.Row="1" ItemTemplate="{StaticResource PersonTemplate}" SelectionChanged="showListbox_SelectionChanged" x:Name="showListbox"/>
                <Image Grid.Row="2" x:Name="template" MaxHeight="160"/>
            </Grid>
        </Border>
    </Grid>
</Window>
