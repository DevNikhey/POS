<Window x:Class="UE5_Parkhaus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UE5_Parkhaus"
        mc:Ignorable="d"
        Title="UE5 Parkhaus - Threading" Height="560" Width="900">
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border BorderBrush="SteelBlue" BorderThickness="1" Margin="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="3" Text="Auto"/>
                                <TextBlock Margin="3" Text="{Binding Id}"/>
                                <TextBlock Margin="3" Text="E:"/>
                                <TextBlock Margin="3" Text="{Binding IstElektro}"/>
                                <TextBlock Margin="3" Text="Platz:"/>
                                <TextBlock Margin="3" Text="{Binding Platz}"/>
                                <TextBlock Margin="3" Text="{Binding Status}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="Variante:" VerticalAlignment="Center"/>
            <ComboBox x:Name="comboVariante" Width="180" VerticalAlignment="Center" SelectedIndex="0">
                <ComboBoxItem>EinfachParkhaus</ComboBoxItem>
                <ComboBoxItem>TagNachtParkhaus</ComboBoxItem>
                <ComboBoxItem>LadeParkhaus</ComboBoxItem>
                <ComboBoxItem>KassaParkhaus</ComboBoxItem>
            </ComboBox>
            <Label Content="Anzahl Autos:" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="anzahlBox" Width="60" Text="15" VerticalAlignment="Center"/>
            <Button x:Name="startBtn" Content="Starten" Width="90" Margin="12,0,0,0" Click="StartBtn_Click"/>
            <Label x:Name="statusLabel" Content="Parkhaus: -" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Anfahrt" FontWeight="Bold"/>
            <ListBox Grid.Row="1" Grid.Column="0" x:Name="fahrend" Margin="2"/>

            <Label Grid.Row="0" Grid.Column="1" Content="Im Parkhaus" FontWeight="Bold"/>
            <ListBox Grid.Row="1" Grid.Column="1" x:Name="park" Margin="2"/>

            <Label Grid.Row="0" Grid.Column="2" Content="An der Kassa" FontWeight="Bold"/>
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="kassa" Margin="2"/>
        </Grid>
    </Grid>
</Window>
