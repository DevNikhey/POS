<Window x:Class="UE2_Formen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UE2_Formen"
        mc:Ignorable="d"
        Title="UE2 Formen" Height="450" Width="800">
    <Canvas Background="White">
        <!-- Beispiel-Vieleck: Sechseck (Ecken=6).
             Erst nach Aufgabe 1 + 2 wird hier etwas gezeichnet. -->
        <local:Vieleck X1="150" Y1="150" Radius="90" Ecken="6"
                       Stroke="DarkBlue" StrokeThickness="2" Fill="LightBlue" />

        <!-- AUFGABE 5: zweites Vieleck mit ANDERER Eckenzahl (Dreieck, Ecken=3),
             zeigt dass das Control generisch fuer beliebige Eckenzahlen funktioniert. -->
        <local:Vieleck X1="150" Y1="330" Radius="70" Ecken="3"
                       Stroke="Green" StrokeThickness="2" Fill="LightGreen" />

        <!-- Beispiel-Stern: 5 Zacken.
             Erst nach Aufgabe 3 + 4 sichtbar. -->
        <local:Stern X1="500" Y1="180" AussenRadius="100" InnenRadius="45" Zacken="5"
                     Stroke="DarkRed" StrokeThickness="2" Fill="Gold" />
    </Canvas>
</Window>
