<Window x:Class="PA1_4B_2025.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PA1_4B_2025"
        mc:Ignorable="d"
        Title="1. praktische Arbeit" Height="650" Width="1000">
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border BorderBrush="RoyalBlue" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="3">Plane</TextBlock>
                                <TextBlock Margin="3" Text="{Binding Id}"></TextBlock>
                                <TextBlock Margin="3">Vip</TextBlock>
                                <TextBlock Margin="3" Text="{Binding IsVip}"></TextBlock>
                                <TextBlock Margin="3">Landing Strip</TextBlock>
                                <TextBlock Margin="3" Text="{Binding LandingStrip}"></TextBlock>
                                <TextBlock Margin="3">Status</TextBlock>
                                <TextBlock Margin="3" Text="{Binding Status}"></TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

       
        <ListBox Grid.Row="1" x:Name="Flying" Height="150" Grid.ColumnSpan="4" Grid.RowSpan="2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid></UniformGrid>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Label Grid.Row="0" Content="Zielflughafen" HorizontalAlignment="Left"  VerticalAlignment="Top"/>
        <ComboBox Grid.Row="0" Grid.Column="0" x:Name="comboAirport" HorizontalAlignment="Left" VerticalAlignment="Top" Width="52" Margin="79,4,0,0">
            <ComboBoxItem>SimpleAirport</ComboBoxItem>
            <ComboBoxItem>MediumAirport</ComboBoxItem>
            <ComboBoxItem>BigAirport</ComboBoxItem>
            <ComboBoxItem>VipAirport</ComboBoxItem>
        </ComboBox>


        <Label Grid.Row="0" Grid.Column="1" Content="Anzahl neue Flugzeuge" HorizontalAlignment="Left" Margin="0,4,0,0" VerticalAlignment="Top"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="anzahlNeu" HorizontalAlignment="Left" TextWrapping="Wrap" Text="20" VerticalAlignment="Top" Width="55" Margin="130,10,0,0"/>
        <Button Grid.Row="0" Grid.Column="1" Click="Button_Click" Content="Starten" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="190,8,0,0"/>

        <ListBox Grid.Row="3" Grid.RowSpan="2" x:Name="simpleAirport" Height="230" VerticalAlignment="Bottom"/>
        <Label Grid.Row="3" x:Name="simpleLabelUI" Content="Simple Airport - Loading" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, -10, 0, 0"/>

        <Label Grid.Row="3" Grid.Column="1" Content="Medium Airport - Loading" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, -10, 0, 0"/>
        <ListBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" x:Name="mediumAirport" Height="230" VerticalAlignment="Bottom"/>

        <Label Grid.Row="3" Grid.Column="2" Content="Big Airport - Loading" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, -10, 0, 0"/>
        <ListBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" x:Name="bigAirportUI" Height="230" VerticalAlignment="Bottom"/>

        <Label Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Content="Vip Airport - Loading" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, -10, 0, 0"/>
        <ListBox Grid.Row="3" Grid.RowSpan="2" Grid.Column="3" x:Name="vipAirport" Height="230" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
