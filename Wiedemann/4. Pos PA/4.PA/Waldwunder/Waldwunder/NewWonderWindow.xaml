<Window x:Class="Waldwunder.NewWonderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waldwunder"
        mc:Ignorable="d"
        Title="NewWonderWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="Name: "></TextBlock>
        <TextBox x:Name="NameTextBox" Grid.Column="1"></TextBox>
        <TextBlock Text="Beschreibung: " Grid.Row="1"></TextBlock>
        <TextBox x:Name="BeschreibungTextBox" Grid.Column="1" Grid.Row="1"></TextBox>
        <TextBlock Text="Bundesland: " Grid.Row="2"></TextBlock>
        <ComboBox x:Name="ProvinceComboBox" Grid.Row="2" Grid.Column="1"></ComboBox>
        <TextBlock Text="Art: " Grid.Row="3"></TextBlock>
        <TextBox x:Name="TypeTextBox" Grid.Column="1" Grid.Row="3"></TextBox>
        <TextBlock Text="Latitude: " Grid.Row="4"></TextBlock>
        <TextBox x:Name="LatitudeTextBox" Grid.Column="1" Grid.Row="4"></TextBox>
        <TextBlock Text="Longitude: " Grid.Row="5"></TextBlock>
        <TextBox x:Name="LongitudeTextBox" Grid.Column="1" Grid.Row="5"></TextBox>
        <TextBlock Text="Bilder: " Grid.Row="6"></TextBlock>
        <ListBox x:Name="ImagesListBox" Grid.Row="6" Grid.Column="1"/>
        <DockPanel HorizontalAlignment="Center" Grid.Row="7">
            <Button Click="addImage">Hinzufügen</Button>
            <Button Click="deleteImage">Entfernen</Button>
        </DockPanel>

        <Button Grid.ColumnSpan="2" HorizontalAlignment="Center" Grid.Row="8" Click="register">Registrieren</Button>
    </Grid>
</Window>
