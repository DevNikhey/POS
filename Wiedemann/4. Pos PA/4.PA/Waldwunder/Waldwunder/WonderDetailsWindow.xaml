<Window x:Class="Waldwunder.WonderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waldwunder"
        mc:Ignorable="d"
        Title="WonderDetailsWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="NameTextBlock"></TextBlock>
        <TextBlock x:Name="BeschreibungTextBlock" Grid.Row="1"></TextBlock>
        <TextBlock x:Name="BundeslandTextBlock" Grid.Row="2"></TextBlock>
        <TextBlock x:Name="ArtTextBlock" Grid.Row="3"></TextBlock>
        <TextBlock x:Name="LatitudeTextBlock" Grid.Row="4"></TextBlock>
        <TextBlock x:Name="LongitudeTextBlock" Grid.Row="5"></TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="6">
            <WrapPanel x:Name="ImagesPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
