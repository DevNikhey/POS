<Window x:Class="simplChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:simplChatClient"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <!--<Button Click="Connect_Click">Verbinden</Button>-->
            <TextBlock x:Name="StatusText"></TextBlock>
            <TextBox x:Name="Nachrichtenbox"></TextBox>
            <Button Click="Send_Click">Senden</Button>
            <TextBlock x:Name="Show"></TextBlock>
        </StackPanel>
        
    </Grid>
</Window>
