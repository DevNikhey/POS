<Window x:Class="Gomoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gomoku"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <ItemsControl ItemsSource="{Binding Board.Cells}">

            <!-- Layout -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding BoardSize}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- Darstellung eines Feldes -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Button Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">

                        <Border BorderBrush="Black" BorderThickness="0.5">
                            <Grid Background="Beige">

                                <TextBlock Text="{Binding OccupiedBy}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"/>

                            </Grid>
                        </Border>

                    </Button>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>
</Window>
