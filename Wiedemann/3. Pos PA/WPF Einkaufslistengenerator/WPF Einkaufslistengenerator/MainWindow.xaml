<Window x:Class="WPF_Einkaufslistengenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Einkaufslistengenerator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" Command="{Binding NewCommand}"/>
                <MenuItem Header="Speichern" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Laden" Command="{Binding LoadCommand}"/>
                <Separator/>
                <MenuItem Header="Drucken" Command="{Binding PrintCommand}"/>
                <Separator/>
                <MenuItem Header="Löschen" Command="{Binding DeleteCommand}"/>
            </MenuItem>
        </Menu>
        <StackPanel Margin="20">
            <!-- SUCHFELD -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Width="200"
         Margin="0,0,0,5" />

            <!-- SUCH RESULT -->
            <ComboBox ItemsSource="{Binding SearchResults}"
          SelectedItem="{Binding SelectedSearchProduct}"
          DisplayMemberPath="Name"
          Width="200"
          Margin="0,0,0,10"/>

            <!-- Gruppe -->
            <ComboBox ItemsSource="{Binding ProductGroups}"
              SelectedItem="{Binding SelectedGroup}"
              Width="200" Margin="0,0,0,10"/>

            <!-- Produkte -->
            <ComboBox ItemsSource="{Binding Products}"
              SelectedItem="{Binding SelectedProduct}"
              DisplayMemberPath="Name"
              Width="200" Margin="0,0,0,10"/>

            <!-- Eigenes Produkt -->
            <TextBox Text="{Binding CustomProductName}"
             Width="200"
             Margin="0,0,0,10"/>

            <!-- Menge -->
            <TextBox Text="{Binding Quantity}"
             Width="200"
             Margin="0,0,0,10"/>

            <!-- Button -->
            <Button Content="Hinzufügen"
            Command="{Binding AddCommand}"
            Width="200"
            Margin="0,0,0,20"/>

            <!-- Liste -->
            <ListBox ItemsSource="{Binding ShoppingList}" Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="150"/>
                            <TextBlock Text="{Binding Quantity}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TreeView ItemsSource="{Binding GroupedItems}" Height="200">

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Items}">

                        <!-- Gruppenname -->
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>

                        <!-- Kinder (Produkte) -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Width="150"/>
                                    <TextBlock Text="{Binding Quantity}"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>

                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

            </TreeView>

        </StackPanel>
    </Grid>
</Window>
